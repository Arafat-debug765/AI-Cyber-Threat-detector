# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/

# Secrets — the HMAC key authenticating the model. Committing it would make
# the signature worthless: anyone could forge a model this app would load.
.secrets/
*.key
.env

# Project artefacts — regenerate, don't commit
data/*.csv
models/*
*.pkl

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editors
.DS_Store
.idea/
.vscode/
