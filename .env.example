# Copy to .env and adjust. All values are optional; defaults shown.

# ---- Data ----------------------------------------------------------------
# The capture under inspection.
DATA_FILE=data/packets.csv
# Known-good traffic to fit on. THIS IS THE IMPORTANT ONE: without it the model
# is fitted on the same traffic it inspects, which teaches it that any attack
# present is part of normal, and reduces alerting to a fixed quota.
# BASELINE_FILE=data/baseline.csv
MODEL_FILE=models/model.pkl

# ---- Detection -----------------------------------------------------------
# "flow" aggregates packets into (source, window) sessions — required to see
# port scans, sweeps and beaconing. "packet" scores each packet alone.
FEATURE_SET=flow
# Session window. Must be longer than the period of any beacon you hope to see;
# too long and bursts average away. 300s detects all four reference attacks.
WINDOW_SECONDS=300
# Windows with fewer packets than this are capture-boundary artifacts, not
# behaviour. Leaving them in lets one of them set the alert threshold.
MIN_SESSION_PACKETS=3

# Detector: "iforest" (default) or "lof".
ALGORITHM=iforest
N_ESTIMATORS=100
RANDOM_STATE=42

# "auto" keeps scikit-learn's data-independent score offset. A number turns
# detection into a quota: it flags that fraction whether or not anything is
# wrong.
CONTAMINATION=auto

# Target false-positive rate. The threshold is set at this quantile of the
# BASELINE's scores, so 0.02 means "accept ~2% of known-good sessions alarming".
# Measured default: 0.02 catches all four reference attacks in every run; 0.0
# ("nothing known-good may alarm") catches them in six runs out of eight,
# because the bar is then set by the baseline's single weirdest session.
CALIBRATION_QUANTILE=0.02
# Hard override of the calibrated threshold.
# SCORE_THRESHOLD=-0.15

# ---- Access control ------------------------------------------------------
# Required to serve on anything but loopback; `serve` refuses without it.
# Generate with: openssl rand -hex 32
# API_TOKEN=

# Host headers this instance answers to. Blocks DNS rebinding, which is how a
# website turns your loopback-only service into one it can read.
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# HMAC key protecting the model file from being swapped for a hostile pickle.
# Prefer providing the key itself from a secret store; the file is the fallback.
MODEL_KEY_FILE=.secrets/model_signing.key
# MODEL_SIGNING_KEY=

# Nothing here accepts uploads; a larger body is a mistake or an attack.
MAX_CONTENT_LENGTH=1048576

# ---- Server --------------------------------------------------------------
MAX_RESULTS=500
# Never enable debug on a reachable host: the Werkzeug debugger grants remote
# code execution.
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
